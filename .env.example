# RAVS Smart School - Production Environment Configuration
# Copy this file to .env and fill in your school's credentials

# Google Gemini AI Assistant API Key
# Get a free API key at https://aistudio.google.com/
VITE_GEMINI_API_KEY=""

# Firebase Cloud Database & Authentication (Optional / Production Cloud Mode)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="ravs-smart-school.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="ravs-smart-school"
VITE_FIREBASE_STORAGE_BUCKET="ravs-smart-school.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Application Details
VITE_APP_NAME="RAVS Smart School"
VITE_APP_VERSION="1.0.0"
